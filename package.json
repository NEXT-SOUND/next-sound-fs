{
  "name": "universal-app-starter",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "web": "cd apps/web && yarn run dev",
    "ios": "cd apps/native && yarn ios",
    "prebuild": "cd apps/native && expo prebuild",
    "android": "cd apps/native && yarn android",
    "backend": "cd apps/backend && npm run start",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "codegen": "graphql-codegen --config codegen.yml",
    "codegen:watch": "graphql-codegen --config codegen.yml --watch",
    "lint": "eslint packages apps/web/pages apps/web/lib apps/native/app --ext .ts,.tsx,.js,.jsx --ignore-pattern '**/node_modules/**' --ignore-pattern '**/.next/**' --ignore-pattern '**/build/**'",
    "lint:fix": "eslint packages apps/web/pages apps/web/lib apps/native/app --ext .ts,.tsx,.js,.jsx --fix --ignore-pattern '**/node_modules/**' --ignore-pattern '**/.next/**' --ignore-pattern '**/build/**'",
    "type-check": "tsc --noEmit --project apps/web/tsconfig.json",
    "check-all": "npm run type-check && npm run lint",
    "fix-all": "npm run lint:fix && npm run format"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@1.22.19",
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/typescript": "^5.0.1",
    "@graphql-codegen/typescript-operations": "^5.0.1",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "clsx": "^2.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "prettier": "^3.3.2",
    "tailwind-merge": "^2.5.2",
    "turbo": "^2.0.4",
    "typescript-eslint": "^8.46.0"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "dependencies": {
    "@apollo/client": "^4.0.7",
    "@tanstack/react-query": "^5.90.2",
    "class-variance-authority": "^0.7.1",
    "dayjs": "^1.11.13",
    "graphql": "^16.11.0",
    "lucide-react": "^0.469.0",
    "react-hook-form": "^7.65.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.1"
  }
}
