{
  "name": "universal-app-starter",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "web": "cd apps/web && yarn run dev",
    "ios": "cd apps/native && yarn ios",
    "prebuild": "cd apps/native && expo prebuild",
    "android": "cd apps/native && yarn android",
    "backend": "cd apps/backend && npm run start",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "codegen": "graphql-codegen --config codegen.yml",
    "codegen:watch": "graphql-codegen --config codegen.yml --watch"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@1.22.19",
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/typescript": "^5.0.1",
    "@graphql-codegen/typescript-operations": "^5.0.1",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "clsx": "^2.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.3.2",
    "tailwind-merge": "^2.5.2",
    "turbo": "^2.0.4"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "dependencies": {
    "@apollo/client": "^4.0.7",
    "@tanstack/react-query": "^5.90.2",
    "class-variance-authority": "^0.7.1",
    "dayjs": "^1.11.13",
    "graphql": "^16.11.0",
    "lucide-react": "^0.469.0",
    "react-i18next": "^15.5.3",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.1"
  }
}